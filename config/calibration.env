CAM0_TOPIC="/camera/infra1/image_rect_raw"
CAM1_TOPIC="/camera/infra2/image_rect_raw"
IMU_TOPIC="/camera/imu"
IMAGE_WIDTH="640"
IMAGE_HEIGHT="480"
IMAGE_FPS="30"
IMU_RATE="200"
TARGET_YAML="${KIT_ROOT}/config/aprilgrid_6x6_A4_24mm.yaml"
ALLAN_CONFIG="${KIT_ROOT}/config/realsense_d435i.yaml"
