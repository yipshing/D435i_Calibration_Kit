#!/usr/bin/env bash
KIT_ROOT="/home/yip/D435i_Calibration_Kit_2"
DATA_ROOT="${KIT_ROOT}/calibration_data"
REALSENSE_SETUP="/home/yip/catkin_ws/devel/setup.bash"
KALIBR_SETUP="/home/yip/kalibr_ws/devel/setup.bash"
ALLAN_SETUP="/home/yip/allan_variance_ws/devel/setup.bash"
# Leave empty to use the only connected D435i. Fill this after checking
# rs-enumerate-devices if the computer may have multiple RealSense cameras.
